# Supabase (opcional - la app funciona sin esto usando localStorage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Credenciales del admin (modo offline/localStorage y admin-bypass)
# IMPORTANTE: Cambia estos valores antes de desplegar en producción.
# Si VITE_ADMIN_PASSWORD no se configura, el admin-bypass queda deshabilitado.
VITE_ADMIN_EMAIL=admin@tudominio.com
VITE_ADMIN_PASSWORD=tu-contraseña-segura-aqui
