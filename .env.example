# Supabase (opcional - la app funciona sin esto usando localStorage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Correo del admin (solo para reconocer la cuenta de admin en el frontend).
VITE_ADMIN_EMAIL=admin@tudominio.com

# ⚠️ NO uses VITE_ADMIN_PASSWORD. El "admin-bypass" fue ELIMINADO por seguridad:
# cualquier variable con prefijo VITE_ se hornea en el bundle público del
# navegador, así que una contraseña de admin ahí es extraíble por cualquiera.
# El admin ahora entra con su cuenta REAL de Supabase (JWT + role='admin').
# En producción: NO definas VITE_ADMIN_PASSWORD (frontend) ni ADMIN_PASS
# (edge functions) — ya no se usan y deben quedar sin configurar.
