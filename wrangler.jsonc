// Cloudflare Workers (static assets). En Vercel este archivo se ignora.
// La página sale de ./dist; solo /webhooks/* pasa por el worker, que los
// reenvía a Supabase igual que los rewrites de vercel.json.
{
  "name": "lincoln",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/webhooks/*"]
  }
}
